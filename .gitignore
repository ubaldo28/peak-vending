# Dependencies and build output
node_modules/
dist/
.astro/
.wrangler/

# Secrets. .dev.vars is how Wrangler loads secrets locally — it holds real
# API keys and must never be committed.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Scratch. Archives and temp files used when moving work between machines.
*.tar.gz
*.zip
_to_delete/
_tmp-*
_sync*
_pvsrc*

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
npm-debug.log*
yarn-error.log*
