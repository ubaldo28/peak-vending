---
interface Props { name: string; class?: string; size?: number }
// Size is an attribute, not CSS: scoped styles in a parent component never
// reach this SVG, so CSS-only sizing silently fell back to 100% width.
const { name, class: className = '', size = 20 } = Astro.props;

const paths: Record<string, string> = {
  layers: '<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/>',
  calendar: '<path d="M4 6h16v13H4z"/><path d="M4 10h16"/><path d="M9 6V3M15 6V3"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 01-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 015.4-5.4z"/>',
  card: '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>',
  chart: '<path d="M12 20v-6"/><path d="M5 20v-9"/><path d="M19 20V7"/><path d="M3 20h18"/>',
  shield: '<path d="M12 3l8 4v6c0 4.4-3.3 7.4-8 8.6C7.3 20.4 4 17.4 4 13V7z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  coffee: '<path d="M4 8h13v6a5 5 0 01-5 5H9a5 5 0 01-5-5z"/><path d="M17 9h2a2.5 2.5 0 010 5h-2"/><path d="M6 3v2M10 3v2M14 3v2"/>',
  market: '<path d="M3 8l1.5-4h15L21 8"/><path d="M4 8h16v12H4z"/><path d="M9 20v-6h6v6"/>',
  check: '<path d="M4 12l5 5L20 7"/>',
  arrow: '<path d="M5 12h13"/><path d="M13 6l6 6-6 6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a12 12 0 005 5L15 13l5 2v4a1 1 0 01-1.1 1A16 16 0 014 5.1 1 1 0 015 4z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  pin: '<path d="M12 21s-7-4.4-7-9.6A7 7 0 0112 4a7 7 0 017 7.4C19 16.6 12 21 12 21z"/><circle cx="12" cy="11" r="2.4"/>',
};

const d = paths[name] ?? paths.check;
const isCheck = name === 'check';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={isCheck ? 2.4 : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>
