---
interface Props { class?: string; width?: string; }
const { class: className = '', width } = Astro.props;
---

<svg
  class:list={['machine', className]}
  viewBox="0 0 200 300"
  style={width ? `width:${width}` : undefined}
  role="presentation"
  aria-hidden="true"
>
  <use href="#pvMachine" />
</svg>

<style>
  .machine { display: block; height: auto; }
</style>
