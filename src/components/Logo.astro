---
interface Props {
  /** 'full' is the stacked lockup, 'mark' is the mountain on its own. */
  variant?: 'full' | 'mark';
  /** Rendered width in px. Height follows the aspect ratio via CSS. */
  width?: number;
  class?: string;
  /** Set on the decorative copies so screen readers hear the name once. */
  decorative?: boolean;
}

const { variant = 'full', width = 132, class: className = '', decorative = false } = Astro.props;

const isFull = variant === 'full';
const viewBox = isFull ? '0 0 1882 978' : '0 0 1211 700';
const href = isFull ? '#pvFull' : '#pvMark';
---

<svg
  class:list={['logo', className]}
  viewBox={viewBox}
  width={width}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'Peak Vending'}
>
  <use href={href} />
</svg>

<style>
  .logo { display: block; height: auto; }
</style>
