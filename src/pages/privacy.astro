---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';

// DRAFT. This describes what the site actually does today — a contact form and
// nothing else. Have it checked before launch, and update it the moment you add
// analytics, an advertising pixel, or any third-party embed.
const updated = 'August 2026';
---

<Base
  title="Privacy"
  description="How Peak Vending handles the information you send through this website."
>
  <section class="section legal">
    <div class="wrap">
      <p class="eyebrow">Privacy</p>
      <h1>What we do with your details.</h1>
      <p class="legal__meta">Last updated {updated}</p>

      <h2>Who we are</h2>
      <p>
        {site.legalName} is the data controller for this website. You can reach
        us at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>

      <h2>What we collect</h2>
      <p>
        Only what you type into the contact form: your name, your email address,
        the business or site you are enquiring about, the type of site you
        select, and anything you write in the message box. Nothing else on this
        website collects information about you.
      </p>

      <h2>Why we collect it, and our lawful basis</h2>
      <p>
        To reply to your enquiry and, if it goes any further, to arrange a site
        visit and quote. Our lawful basis under UK GDPR is legitimate interests
        &mdash; responding to someone who has deliberately contacted us about our
        services. We do not use your details for marketing unless you ask us to.
      </p>

      <h2>Who else sees it</h2>
      <p>
        Form submissions reach us by email through a third-party email provider,
        and this site is hosted on a content delivery network. Both handle the
        submission in transit as processors on our instructions. Neither uses it
        for their own purposes, and we do not sell or rent your details to
        anybody.
      </p>

      <h2>Cookies and tracking</h2>
      <p>
        This site sets no cookies and runs no analytics or advertising trackers.
        If that changes, this page gets updated first.
      </p>

      <h2>How long we keep it</h2>
      <p>
        Enquiries stay in our email for as long as the conversation is useful to
        either of us. Ask and we will delete yours.
      </p>

      <h2>Your rights</h2>
      <p>
        Under UK data protection law you can ask us for a copy of what we hold
        about you, ask us to correct it or delete it, or object to how we are
        using it. Email us and we will deal with it directly.
      </p>
      <p>
        If you are not happy with how we have handled it, you can complain to the
        Information Commissioner&rsquo;s Office at
        <a href="https://ico.org.uk" rel="noopener">ico.org.uk</a> or on
        0303 123 1113.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal .wrap { max-width: 68ch; }
  .legal h1 { max-width: 16ch; margin-block: var(--sp-2) 0.5rem; }
  .legal__meta { color: var(--muted); font-size: 0.9375rem; margin-bottom: var(--sp-5); }
  .legal h2 { font-size: var(--step-3); margin-top: var(--sp-5); margin-bottom: var(--sp-2); }
  .legal p { color: var(--muted); }
</style>
