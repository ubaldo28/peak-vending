---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Sponsors from '../components/Sponsors.astro';
import { site } from '../data/site';

const steps = [
  {
    title: 'You get in touch',
    body: 'The address, what sort of building it is, and roughly how many folk are in it. That is us started.',
  },
  {
    title: 'We visit the site',
    body: 'We come round, look at the space, check the power, and work out where folk actually walk.',
  },
  {
    title: 'You approve the plan',
    body: 'Machine, range and prices, written down before anything is ordered.',
  },
  {
    title: 'We install and take over',
    body: 'Delivery, positioning, filling, and every visit after that. You get a name and a number.',
  },
];

const principles = [
  {
    icon: 'shield',
    title: 'The site never pays a penny',
    body: 'Nothing to buy, nothing to lease, no maintenance contract, no minimum. We carry the cost of the machine because we reckon it ought to earn its place.',
  },
  {
    icon: 'wrench',
    title: 'One number, and we answer it',
    body: 'Your maintenance folk should never have to open a vending machine. There is a sticker on every one of ours and it rings us, not a manufacturer.',
  },
  {
    icon: 'chart',
    title: 'If it does not sell, it goes',
    body: 'A machine nobody uses is worse than no machine at all. If a site is not shifting anything after a fair go, we will say so and take it away.',
  },
];
---

<Base
  title="About"
  description="Peak Vending is an independent, full-service vending operator based in Dundee, covering Angus, Fife and Perthshire. We install, fill and maintain machines at no cost to the site."
>
  <section class="section section--tight head">
    <div class="wrap">
      <p class="eyebrow">About Peak Vending</p>
      <h1>A vending firm that turns up.</h1>
      <p class="head__sub">
        Most complaints about vending are not really about the machine. They are
        about the fortnight it sat empty, or the call nobody returned. We built
        the business round fixing that, which is a low bar and a surprisingly
        rare one.
      </p>
    </div>
  </section>

  <div class="ridge"></div>

  <section class="section">
    <div class="wrap story">
      <div class="reveal">
        <p class="eyebrow">Why we exist</p>
        <h2>Vending is a service business dressed up as a bit of kit.</h2>
      </div>
      <div class="story__body reveal">
        <p>
          Anyone can stick a machine in a room. The difference between something
          folk are glad of and a bit of furniture they moan about is entirely
          what happens after it is fitted &mdash; whether it gets filled on a set
          run, whether the range matches what your lot actually buy, and whether
          a fault gets sorted this week or next month.
        </p>
        <p>
          That is the part we are set up for. We work set runs rather than
          call-outs, we share the sales figures with the sites we look after, and
          we would sooner take a machine away from somewhere it is not working
          than leave it sitting there earning nothing and annoying everybody.
        </p>
        <p>
          We are based in Dundee and independent, and we intend to stay that way.
          It means we only take on sites we can genuinely get round, and it means
          the person who quotes you is the person you will still be dealing with
          a year later.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="lede reveal">
        <p class="eyebrow">How we work</p>
        <h2>Three things we will not budge on.</h2>
      </div>
      <div class="grid-3">
        {principles.map((item) => (
          <div class="card reveal">
            <Icon name={item.icon} class="card__icon" size={38} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="lede reveal">
        <p class="eyebrow">Getting started</p>
        <h2>Four steps, and none of them land on you.</h2>
      </div>
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="reveal">
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Sponsors variant="feature" heading="The businesses that back us" />

  <section class="section cta">
    <div class="wrap cta__simple">
      <div>
        <p class="eyebrow">Talk to us</p>
        <h2>Serving {site.areaServed}.</h2>
        <p>Send us the details and we&rsquo;ll come round and have a look.</p>
      </div>
      <a href="/contact/" class="btn btn--light">Request a site visit</a>
    </div>
  </section>
</Base>

<style>
  .head h1 { max-width: 16ch; margin-block: var(--sp-2) var(--sp-3); }
  .head__sub { color: var(--muted); font-size: var(--step-1); max-width: 58ch; }

  .story { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--sp-6); align-items: start; }
  .story h2 { margin-top: var(--sp-2); max-width: 18ch; }
  .story__body { color: var(--muted); }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }
  .steps li { border-top: 2px solid var(--line); padding-top: var(--sp-3); }
  .steps__n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    color: var(--blue);
    margin-bottom: 0.6rem;
  }
  .steps h3 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .steps p { color: var(--muted); font-size: 0.96875rem; }

  .cta__simple { grid-template-columns: 1fr auto; align-items: center; }

  @media (max-width: 900px) {
    .story, .steps { grid-template-columns: 1fr; }
    .cta__simple { grid-template-columns: 1fr; }
  }
</style>
