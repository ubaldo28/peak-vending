{
  // Cloudflare Workers config. `astro build` merges this with an adapter-generated
  // config and writes the result to dist/server/wrangler.json, which is what
  // `npm run deploy` ships.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-vending",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Keeps peak-vending.peakvending.workers.dev alive as a staging URL.
  // Set to false once the real domain is live, so Google does not index both.
  "workers_dev": true,

  // Custom domains. Wrangler creates the DNS records and certificates on
  // deploy, so the dashboard is not involved.
  "routes": [
    { "pattern": "peak-vending.com", "custom_domain": true },
    { "pattern": "www.peak-vending.com", "custom_domain": true }
  ],

  // Contact-form rate limiting: 5 submissions per IP per hour. The endpoint
  // looks for this binding and enables the limit when it finds one, so a fork
  // without the namespace still runs — it just does not rate limit.
  // Recreate with: npx wrangler kv namespace create RATE_LIMIT
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "344ae7da8b404b9ea0f95ccc797df945" }
  ]
}
