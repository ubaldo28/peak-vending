# Copy to .env for local development. In production these are Cloudflare
# secrets, not files — see the README.
#
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_TO
#   npx wrangler secret put CONTACT_FROM

# Resend API key — https://resend.com (free tier covers a site this size)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries land.
CONTACT_TO=hello@peak-vending.com

# Must be an address on a domain you have verified in Resend.
CONTACT_FROM=website@peak-vending.com

# Optional. Only set this to point at a different Resend-compatible endpoint,
# e.g. a local mock while testing. Leave unset in production.
# RESEND_ENDPOINT=
