# Local development only. Copy to .env — which is gitignored — and fill in.
#
# In production none of this lives in a file. Each value is a Cloudflare
# Workers secret, encrypted at rest and never present in the repo:
#
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_TO
#   npx wrangler secret put CONTACT_FROM
#   npx wrangler secret put CONTACT_ACK_FROM

# Resend API key. Scope it to "Sending access" on the one domain — a key that
# can only send from one domain is a much smaller problem if it ever leaks.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries land.
CONTACT_TO=info@example.com

# The internal notification. Must be an address on a Resend-verified domain.
CONTACT_FROM=Example Website <noreply@example.com>

# The acknowledgement the enquirer receives. Falls back to CONTACT_FROM when
# unset, but a real monitored address reads better to a customer than noreply@.
CONTACT_ACK_FROM=Example <info@example.com>

# Optional. Points the endpoint at a different Resend-compatible URL — used by
# the local test harness to capture mail instead of sending it. Leave unset in
# production.
# RESEND_ENDPOINT=
